#!/bin/bash
# team <venture> — launch (or resume) one venture's agent team.
#
#   team <venture>   that venture's sessions (directory name under
#                    ventures/). The mentor is NOT included — it sits
#                    above the teams and is launched via `hq mentor`.
#   team mentor      the mentor alone (what `hq mentor` calls)
#   team plumber     the plumber alone (what `hq plumber` calls) —
#                    HQ-level like the mentor
#   team designer    the portfolio designer alone (what `hq designer`
#                    calls) — HQ-level like the mentor, never bundled
#                    into a venture launch
#   team all         the entire roster — every venture's agents at once.
#                    Explicit keyword on purpose: with many ventures this
#                    is a lot of sessions, so it must never fire by accident.
#   team stop <x>    end <x>'s agents running under tmux (a venture,
#                    mentor/plumber/designer, or all). Every session is
#                    saved as it goes, so the next launch resumes it.
#   team             no launch — prints usage, the known ventures, and
#                    which teams are running under tmux
#
# Roster: ~/code/business/hq/team.conf (name|directory|first-launch
# flags|every-launch flags; paths written as ~/, expanded here); `hq new` appends entries. Every-launch flags
# (optional 4th field) are repeated on resume — for things a resumed
# session would otherwise lose, like the designer's --plugin-dir. First run creates each named session
# under a fixed uuid (stored in .team-state/<name>); later runs resume
# that uuid exactly where it left off. Uses tmux when installed:
# a private tmux server (socket "hq", config hq/tmux.conf) holding one
# tmux session per venture or hq role, one window per agent; in iTerm it
# attaches through iTerm's tmux integration, so windows are native tabs.
# Agents keep running when the terminal closes. Without tmux, one iTerm
# window with a tab per agent. Re-running is safe in both modes: agents
# already running are detected (by session name in the process table)
# and skipped, never duplicated.

set -u

# HQ_TEAM_CONF / HQ_TEAM_STATE / HQ_TMUX_SOCKET / HQ_TEAM_NO_ATTACH exist
# for testing against a throwaway roster; nothing else sets them.
CONF="${HQ_TEAM_CONF:-$HOME/code/business/hq/team.conf}"
STATE_DIR="${HQ_TEAM_STATE:-$HOME/code/business/hq/.team-state}"
mkdir -p "$STATE_DIR"
TX=(tmux -L "${HQ_TMUX_SOCKET:-hq}" -f "$HOME/code/business/hq/tmux.conf")

FILTER="${1:-}"

# HQ-level sessions: launched by their own name, never as part of a venture.
HQ_LEVEL="mentor plumber designer"
is_hq_level() { case " $HQ_LEVEL " in *" $1 "*) return 0 ;; esac; return 1; }

list_ventures() {
  grep -v '^\s*#' "$CONF" | grep -v '^\s*$' | while IFS='|' read -r name dir _; do
    is_hq_level "$name" || basename "$dir"
  done | sort -u
}

running_teams() { # tmux sessions on the hq server, one per line
  command -v tmux >/dev/null 2>&1 || return 0
  "${TX[@]}" list-sessions -F '  #S — #{session_windows} agent(s)#{?session_attached, (open),}' 2>/dev/null
}

if [ -z "$FILTER" ]; then
  echo "usage: team <venture> | team mentor | team plumber | team designer | team all" >&2
  echo "       team stop <venture> | team stop all" >&2
  echo "known ventures:" >&2
  list_ventures | sed 's/^/  /' >&2
  r=$(running_teams)
  [ -n "$r" ] && { echo "running under tmux:" >&2; echo "$r" >&2; }
  exit 1
fi

if [ "$FILTER" = stop ]; then
  target="${2:-}"
  [ -z "$target" ] && { echo "usage: team stop <venture> | mentor | plumber | designer | all" >&2; exit 1; }
  command -v tmux >/dev/null 2>&1 || { echo "team: tmux isn't installed — close the agents' tabs instead." >&2; exit 1; }
  if [ "$target" = all ]; then
    "${TX[@]}" kill-server 2>/dev/null && echo "team: stopped every team running under tmux." \
      || echo "team: nothing is running under tmux."
  else
    "${TX[@]}" kill-session -t "=$target" 2>/dev/null && echo "team: stopped '$target'." \
      || echo "team: '$target' isn't running under tmux."
  fi
  exit 0
fi

# Each agent gets a fixed session UUID, minted here on first launch and
# stored in its state file. Resuming by UUID is deterministic; resuming
# by display name is not (`claude --resume <name>` opens an interactive
# picker when the name matches nothing — e.g. a first-launch tab that
# was closed before the session persisted — stranding the tab).
uuid_for() { # name -> that agent's session uuid, minting one if needed
  local sf="$STATE_DIR/$1"
  if [ -s "$sf" ]; then
    cat "$sf"
  else
    uuidgen | tr 'A-Z' 'a-z' | tee "$sf"
  fi
}

session_exists() { # dir uuid -> 0 if the session persisted on disk
  # claude stores sessions per project dir; /, . and _ munge to -.
  [ -f "$HOME/.claude/projects/$(echo "$1" | sed 's|[/._]|-|g')/$2.jsonl" ]
}

cmd_for() { # name dir flags always -> the claude command to run
  local name="$1" dir="$2" flags="$3" always="${4:+$4 }" uuid
  uuid=$(uuid_for "$name")
  if session_exists "$dir" "$uuid"; then
    echo "claude ${always}--resume $uuid"
  else
    # A closed-before-first-message session leaves no file, so the same
    # uuid is simply created again. The resume fallback only matters if
    # claude's on-disk layout changes and session_exists misses a live
    # session — then --session-id would refuse the duplicate.
    echo "claude ${always}$flags --session-id $uuid -n $name || claude ${always}--resume $uuid"
  fi
}

roster() {
  grep -v '^\s*#' "$CONF" | grep -v '^\s*$' | while IFS='|' read -r name dir flags always; do
    if [ "$FILTER" = all ]; then
      :
    elif is_hq_level "$FILTER"; then
      [ "$name" = "$FILTER" ] || continue
    else
      is_hq_level "$name" && continue
      [ "$(basename "$dir")" = "$FILTER" ] || continue
    fi
    # team.conf writes paths as ~/ so one roster works on any machine
    printf '%s|%s|%s|%s\n' "$name" "${dir//\~\//$HOME/}" \
      "${flags//\~\//$HOME/}" "${always//\~\//$HOME/}"
  done
}

# A running agent shows up in the process table either as a first launch
# (-n <name>) or a resume of that agent's uuid.
already_running() { # name
  pgrep -f "claude( .*)? -n $1\$" >/dev/null 2>&1 && return 0
  [ -s "$STATE_DIR/$1" ] && pgrep -f "claude( .*)? --resume $(cat "$STATE_DIR/$1")\$" >/dev/null 2>&1
}

MATCHES=$(roster)
if [ "$(printf '%s\n' "$MATCHES" | grep -c '|')" -lt 1 ]; then
  echo "team: no roster entries match venture '$FILTER'" >&2
  echo "known ventures:" >&2
  list_ventures | sed 's/^/  /' >&2
  exit 1
fi

if command -v tmux >/dev/null 2>&1; then
  # One tmux session per group: each venture, and each hq role alone.
  group_of() { if is_hq_level "$1"; then echo "$1"; else basename "$2"; fi; }
  groups=""
  while IFS='|' read -r name dir flags always; do
    s=$(group_of "$name" "$dir")
    case " $groups " in *" $s "*) ;; *) groups="$groups $s" ;; esac
    if "${TX[@]}" has-session -t "=$s" 2>/dev/null \
       && "${TX[@]}" list-windows -t "=$s" -F '#W' | grep -qxF "$name"; then
      if already_running "$name"; then
        echo "team: '$name' is already running."
        continue
      fi
      # its window is back at a shell prompt: relaunch the agent there
    elif already_running "$name"; then
      echo "team: '$name' is running outside tmux (an iTerm tab?) — skipping."
      continue
    elif "${TX[@]}" has-session -t "=$s" 2>/dev/null; then
      "${TX[@]}" new-window -d -t "=$s:" -n "$name" -c "$dir"
    else
      "${TX[@]}" new-session -d -s "$s" -n "$name" -c "$dir" -x 200 -y 50
    fi
    "${TX[@]}" send-keys -t "=$s:$name" "$(cmd_for "$name" "$dir" "$flags" "$always")" C-m
  done <<<"$MATCHES"

  set -- $groups
  live=""
  for g in "$@"; do "${TX[@]}" has-session -t "=$g" 2>/dev/null && live="$live $g"; done
  set -- $live
  [ $# -eq 0 ] && { echo "team: nothing to attach to (every agent runs outside tmux)."; exit 0; }
  [ $# -gt 1 ] && echo "team: running as tmux sessions:$live — this window opens '$1'; 'hq team <name>' opens another."
  [ -n "${HQ_TEAM_NO_ATTACH:-}" ] && exit 0
  case "${TMUX:-}" in
    *"/${HQ_TMUX_SOCKET:-hq},"*) exec "${TX[@]}" switch-client -t "=$1" ;;
  esac
  if [ "${TERM_PROGRAM:-}" = iTerm.app ] && [ -z "${TMUX:-}" ]; then
    exec "${TX[@]}" -CC attach -t "=$1"
  fi
  TMUX= exec "${TX[@]}" attach -t "=$1"
else
  # One iTerm window, one tab per agent. The whole launch is a single
  # AppleScript so every tab lands in the same window we created.
  # Agents whose claude process is already running are skipped, so
  # re-running can't duplicate the team — it only relaunches whoever is
  # missing.
  script='tell application "iTerm"
    activate
    set newWindow to (create window with default profile)'
  first=1
  count=0
  skipped=0
  while IFS='|' read -r name dir flags always; do
    if already_running "$name"; then
      echo "team: '$name' is already running — skipping."
      skipped=$((skipped + 1))
      continue
    fi
    cmd=$(cmd_for "$name" "$dir" "$flags" "$always")
    if [ "$first" = 1 ]; then
      script="$script
      tell current session of newWindow
        set name to \"${name}\"
        write text \"cd ${dir} && ${cmd}\"
      end tell"
      first=0
    else
      script="$script
      tell newWindow
        set newTab to (create tab with default profile)
        tell current session of newTab
          set name to \"${name}\"
          write text \"cd ${dir} && ${cmd}\"
        end tell
      end tell"
    fi
    count=$((count + 1))
  done <<<"$MATCHES"
  if [ "$count" -eq 0 ]; then
    echo "team: all $skipped agents already running — nothing to open."
    exit 0
  fi
  script="$script
  end tell"
  osascript -e "$script" >/dev/null
  echo "team: opened $count iTerm tabs in one window."
  echo "tip: 'brew install tmux' upgrades this to tabs that keep running"
  echo "     when you close the window."
fi
