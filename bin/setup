#!/bin/bash
# setup — make this clone of hq work on this machine. Idempotent: run it
# after cloning, and again any time (a re-run only fills what's missing).
#
# What it does:
#   1. checks prerequisites (claude, node/npx, tmux or iTerm)
#   2. creates ~/code/business/ventures
#   3. creates the private files (founder.md, ventures.md, ideas.md,
#      accounts.md, rules.md,
#      journal.md) from templates/ if they don't exist yet
#   4. writes team.conf (mentor + plumber) if it doesn't exist yet
#   5. removes any machine-wide skill links (skills load per project)
#   6. adds the `hq` and `team` aliases to your shell rc
#   7. Node per venture: installs each venture's .nvmrc version via nvm
#      and adds a shell hook that switches to it in that folder
#   8. user-level Claude settings: merges the tracked copy
#      (machine/claude-user-settings.json, when this hq has one) into
#      ~/.claude/settings.json — adds what's missing, never overwrites
#
# The clone must live at ~/code/business/hq — every script assumes it.

set -euo pipefail

HQ="$HOME/code/business/hq"
VENTURES="$HOME/code/business/ventures"
HERE="$(cd "$(dirname "$0")/.." && pwd -P)"

if [ "$HERE" != "$HQ" ]; then
  echo "setup: this clone is at $HERE" >&2
  echo "       it must live at $HQ — move it there and re-run." >&2
  exit 1
fi

ok()   { printf '  ok    %s\n' "$*"; }
made() { printf '  made  %s\n' "$*"; }
warn() { printf '  WARN  %s\n' "$*"; }

echo "prerequisites"
command -v claude >/dev/null 2>&1 && ok "claude $(claude --version 2>/dev/null | head -1)" \
  || warn "claude not found — install Claude Code first: https://code.claude.com"
command -v npx >/dev/null 2>&1 && ok "npx (the designers' Playwright MCP needs it)" \
  || warn "npx not found — the designer's browser tooling needs Node"
if command -v tmux >/dev/null 2>&1; then ok "tmux"
elif [ -d "/Applications/iTerm.app" ]; then ok "iTerm (tmux not installed — tabs won't survive closing the terminal)"
else warn "neither tmux nor iTerm found — 'hq team' can't open sessions; install tmux (brew or apt)"; fi

echo "directories"
if [ -d "$VENTURES" ]; then ok "$VENTURES"; else mkdir -p "$VENTURES"; made "$VENTURES"; fi
# Shared by every venture session: the rules import and team protocol.
if [ -e "$VENTURES/CLAUDE.md" ]; then ok "ventures/CLAUDE.md"
else cp "$HQ/templates/ventures-CLAUDE.md" "$VENTURES/CLAUDE.md"; made "ventures/CLAUDE.md"; fi

echo "private files (created from templates/ when missing)"
for f in founder.md ventures.md ideas.md journal.md accounts.md rules.md; do
  if [ -e "$HQ/$f" ]; then ok "$f"
  else cp "$HQ/templates/$f" "$HQ/$f"; made "$f (empty — the mentor fills it in)"; fi
done

if [ -e "$HQ/team.conf" ]; then ok "team.conf"
else
  cat > "$HQ/team.conf" <<EOF
# team roster: session-name|directory|first-launch flags|every-launch flags
# (4th field optional — flags a resumed session would otherwise lose:
# --plugin-dir, and --model, since a resume keeps the transcript's model
# unless --model is passed again)
# Lines starting with # are ignored. \`hq new\` appends entries here.
# Session names are <venture-dir>-<role> so \`team <venture>\` can filter
# and cross-venture messaging never collides. mentor and plumber (HQ-level) are the exceptions.
mentor|~/code/business/hq||--agent mentor --settings ~/code/business/hq/.claude/settings-mentor.json --model opus
plumber|~/code/business/hq||--agent plumber --model opus
EOF
  made "team.conf (mentor + plumber; hq new adds each venture's team)"
fi

echo "skills"
# Skills load per project (relative links in hq/.claude/skills, ventures'
# .claude/skills), never machine-wide. Remove links an older setup made.
for l in "$HOME/.claude/skills"/*; do
  [ -L "$l" ] && case "$(readlink "$l")" in "$HQ"/skills/*) rm "$l"; made "removed machine-wide link $(basename "$l")";; esac
done
ok "per-project links (no machine-wide skills)"


echo "commit hook"
# Hooks don't travel with a clone: without this, commits on a new machine
# skip the hygiene check (and, for the maintainer, the template mirror).
HOOK="$HQ/.git/hooks/post-commit"
if [ -L "$HOOK" ] || [ -e "$HOOK" ]; then ok "post-commit hook"
else ln -s ../../bin/post-commit "$HOOK"; made "post-commit hook (tidy after every commit)"; fi

echo "shell aliases"
case "${SHELL:-}" in */zsh) RC="$HOME/.zshrc" ;; */bash) RC="$HOME/.bashrc" ;; *) RC="$HOME/.profile" ;; esac
if grep -qs 'alias hq=' "$RC"; then ok "hq/team aliases in $RC"
else
  cat >> "$RC" <<'EOF'

# Launch/resume the Claude agent team (hq = founder command center)
alias hq="$HOME/code/business/hq/hq"
alias team="$HOME/code/business/hq/hq team"
EOF
  made "hq/team aliases in $RC (open a new shell to use them)"
fi

echo "node versions (each venture runs its .nvmrc, the version production runs)"
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  set +eu; . "$NVM_DIR/nvm.sh"
  for f in "$VENTURES"/*/.nvmrc; do
    [ -e "$f" ] || continue
    v=$(tr -d '[:space:]' < "$f")
    if nvm ls "$v" >/dev/null 2>&1; then ok "node $v ($(basename "$(dirname "$f")"))"
    else nvm install "$v" >/dev/null 2>&1 && made "node $v ($(basename "$(dirname "$f")"))" || warn "nvm install $v failed"; fi
  done
  set -eu
  if grep -qs '_nvmrc_use' "$RC"; then ok ".nvmrc hook in $RC"
  else
    case "$RC" in
      *.zshrc) cat >> "$RC" <<'EOF'

# Use the Node version in the current folder's .nvmrc (each venture pins its production version).
_nvmrc_use() { [ -f .nvmrc ] && nvm use --silent >/dev/null 2>&1 || true; }
autoload -U add-zsh-hook && add-zsh-hook chpwd _nvmrc_use
command -v nvm >/dev/null && _nvmrc_use
EOF
      ;;
      *) cat >> "$RC" <<'EOF'

# Use the Node version in the current folder's .nvmrc (each venture pins its production version).
_nvmrc_use() { [ -f .nvmrc ] && nvm use --silent >/dev/null 2>&1 || true; }
cd() { builtin cd "$@" && _nvmrc_use; }
command -v nvm >/dev/null && _nvmrc_use
EOF
      ;;
    esac
    made ".nvmrc hook in $RC (open a new shell)"
  fi
else
  warn "nvm not found — install it (github.com/nvm-sh/nvm) so each venture runs its .nvmrc Node version; re-run setup"
fi

echo "user-level Claude settings"
USR="$HQ/machine/claude-user-settings.json"
if [ -e "$USR" ]; then
  r=$(python3 - "$USR" "$HOME/.claude/settings.json" "$HOME" <<'PY'
import json, os, sys
src, dst, home = sys.argv[1:]
want = json.loads(open(src).read().replace("{{HOME}}", home))
have = json.load(open(dst)) if os.path.exists(dst) else {}
added = 0
def merge(w, h):
    global added
    for k, v in w.items():
        if k not in h: h[k] = v; added += 1
        elif isinstance(v, dict) and isinstance(h[k], dict): merge(v, h[k])
        elif isinstance(v, list) and isinstance(h[k], list):
            for x in v:
                if x not in h[k]: h[k].append(x); added += 1
merge(want, have)
if added:
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    open(dst, "w").write(json.dumps(have, indent=2, ensure_ascii=False) + "\n")
print(added)
PY
)
  [ "$r" = 0 ] && ok "~/.claude/settings.json has everything in the tracked copy" || made "~/.claude/settings.json: $r settings restored from machine/claude-user-settings.json"
else
  ok "no tracked user settings in this hq (machine/claude-user-settings.json)"
fi

cat <<EOF

done. next:
  open a new shell, then 'hq mentor' (your advisor — knows every project)
  or 'hq new <name>' for your first venture
  'hq plumber' when you want a command, a charter, or a skill changed
EOF
