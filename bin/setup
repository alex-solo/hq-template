#!/bin/bash
# setup — make this clone of hq work on this machine. Idempotent: run it
# after cloning, and again any time (a re-run only fills what's missing).
#
# What it does:
#   1. checks prerequisites (claude, node/npx, tmux or iTerm)
#   2. creates ~/code/business/ventures
#   3. creates the private files (founder.md, ventures.md, ideas.md,
#      accounts.md, rules.md,
#      journal.md) from templates/ if they don't exist yet
#   4. writes team.conf (mentor + plumber + designer) if it doesn't exist yet
#   5. symlinks skills/* into ~/.claude/skills/
#   6. adds the `hq` and `team` aliases to your shell rc
#
# The clone must live at ~/code/business/hq — every script assumes it.

set -euo pipefail

HQ="$HOME/code/business/hq"
VENTURES="$HOME/code/business/ventures"
HERE="$(cd "$(dirname "$0")/.." && pwd -P)"

if [ "$HERE" != "$HQ" ]; then
  echo "setup: this clone is at $HERE" >&2
  echo "       it must live at $HQ — move it there and re-run." >&2
  exit 1
fi

ok()   { printf '  ok    %s\n' "$*"; }
made() { printf '  made  %s\n' "$*"; }
warn() { printf '  WARN  %s\n' "$*"; }

echo "prerequisites"
command -v claude >/dev/null 2>&1 && ok "claude $(claude --version 2>/dev/null | head -1)" \
  || warn "claude not found — install Claude Code first: https://code.claude.com"
command -v npx >/dev/null 2>&1 && ok "npx (designer's Playwright MCP needs it)" \
  || warn "npx not found — the designer's browser tooling needs Node"
if command -v tmux >/dev/null 2>&1; then ok "tmux"
elif [ -d "/Applications/iTerm.app" ]; then ok "iTerm (tmux not installed — tabs won't survive closing the terminal)"
else warn "neither tmux nor iTerm found — 'hq team' can't open sessions; brew install tmux"; fi

echo "directories"
if [ -d "$VENTURES" ]; then ok "$VENTURES"; else mkdir -p "$VENTURES"; made "$VENTURES"; fi

echo "private files (created from templates/ when missing)"
for f in founder.md ventures.md ideas.md journal.md accounts.md rules.md; do
  if [ -e "$HQ/$f" ]; then ok "$f"
  else cp "$HQ/templates/$f" "$HQ/$f"; made "$f (empty — the mentor fills it in)"; fi
done

if [ -e "$HQ/team.conf" ]; then ok "team.conf"
else
  cat > "$HQ/team.conf" <<EOF
# team roster: session-name|directory|first-launch flags|every-launch flags
# (4th field optional — flags a resumed session would otherwise lose:
# --plugin-dir, and --model, since a resume keeps the transcript's model
# unless --model is passed again)
# Lines starting with # are ignored. \`hq new\` appends entries here.
# Session names are <venture-dir>-<role> so \`team <venture>\` can filter
# and cross-venture messaging never collides. mentor, plumber and designer (HQ-level) are the exceptions.
mentor|$HQ||--agent mentor --settings $HQ/.claude/settings-mentor.json --model opus
plumber|$HQ||--agent plumber --model opus
designer|$VENTURES|--agent designer:designer|--plugin-dir $HQ/designer --model opus
EOF
  made "team.conf (mentor + plumber + designer; hq new adds ventures)"
fi

echo "skills → ~/.claude/skills"
mkdir -p "$HOME/.claude/skills"
for d in "$HQ"/skills/*/; do
  name=$(basename "$d"); link="$HOME/.claude/skills/$name"
  if [ -L "$link" ] && [ "$(readlink "$link")" = "${d%/}" ]; then ok "$name"
  elif [ -e "$link" ]; then warn "$name: $link exists and is not our symlink — left alone"
  else ln -s "${d%/}" "$link"; made "$name"; fi
done

echo "shell aliases"
case "${SHELL:-}" in */zsh) RC="$HOME/.zshrc" ;; */bash) RC="$HOME/.bashrc" ;; *) RC="$HOME/.profile" ;; esac
if grep -qs 'alias hq=' "$RC"; then ok "hq/team aliases in $RC"
else
  cat >> "$RC" <<'EOF'

# Launch/resume the Claude agent team (hq = founder command center)
alias hq="$HOME/code/business/hq/hq"
alias team="$HOME/code/business/hq/hq team"
EOF
  made "hq/team aliases in $RC (open a new shell to use them)"
fi

cat <<EOF

done. next:
  open a new shell, then 'hq mentor' (your advisor — knows every project)
  or 'hq new <name>' for your first venture
  'hq plumber' when you want a command, a charter, or a skill changed
EOF
