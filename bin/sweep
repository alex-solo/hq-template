#!/bin/bash
# sweep — the plumber's weekly hygiene run, unattended.
#
# Runs the plumber headless on the /tidy skill (judgment sweep of every
# agent's charters and memory; bin/tidy is its mechanical half). The
# report goes to .team-state/sweep.log and, in one line, to a macOS
# notification. Scheduled weekly by the launchd job `hq setup` installs;
# run it by hand as `hq sweep`.

set -u
HQ="$HOME/code/business/hq"
LOG="$HQ/.team-state/sweep.log"
mkdir -p "$HQ/.team-state"
cd "$HQ" || exit 1

{ echo "== $(date '+%F %T')"
  claude -p "/tidy" --agent plumber --model opus --permission-mode auto 2>&1
} > "$LOG"

summary=$(grep -v '^\s*$' "$LOG" | sed -n '2p' | cut -c1-180 | tr '"' "'")
osascript -e "display notification \"${summary:-sweep finished}\" with title \"hq sweep\"" >/dev/null 2>&1 || true
