#!/bin/bash
# hq — founder command center. Run `hq` alone to see what exists.
set -u
BIN="$HOME/code/business/hq/bin"

case "${1:-help}" in
  help|-h|--help)
    cat <<'EOF'
hq — founder command center

  hq mentor                   your advisor — above the teams, launched alone
  hq plumber                  the tooling session — scripts, charters,
                              skills, propagation into ventures; a bare
                              `claude` here is the same role, unnamed
  hq designer                 portfolio designer — serves every venture,
                              launched alone
  hq team <venture>           launch/resume that venture's working team
  hq team all                 every venture's team at once (explicit on purpose)
  hq new [name]               start a new venture: short interview, then
                              scaffolding tailored to the venture's shape
  hq new --bare <name> ["thesis"]
                              skip the interview; scaffold the default
                              analyst+builder shape mechanically
  hq onboard                  first run on a fresh clone: setup, then
                              your first mentor session
  hq setup                    the mechanical half of onboard alone
                              (idempotent; safe to re-run any time)
  hq publish                  mirror the shareable files into the public
                              template repo (--check: leak test only)
  hq help                     this list

Roster of sessions:  ~/code/business/hq/team.conf
Full documentation:  ~/code/business/hq/README.md  (or ask the mentor)
EOF
    ;;
  mentor) exec "$BIN/team" mentor ;;
  plumber) exec "$BIN/team" plumber ;;
  designer) exec "$BIN/team" designer ;;
  team) shift; exec "$BIN/team" "$@" ;;
  new|newventure)
    shift
    case "${1:-}" in
      --bare) shift; exec "$BIN/newventure" "$@" ;;
    esac
    cd "$HOME/code/business/hq" && exec claude "/new-venture $*"
    ;;
  setup) exec "$BIN/setup" ;;
  onboard)
    "$BIN/setup" || exit 1
    exec "$BIN/team" mentor
    ;;
  publish) shift; exec "$BIN/publish" "$@" ;;
  *) echo "hq: unknown command '$1' — run 'hq help'" >&2; exit 1 ;;
esac
