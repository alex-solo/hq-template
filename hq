#!/bin/bash
# hq — founder command center. Run `hq` alone to see what exists.
set -u
BIN="$HOME/code/business/hq/bin"

# A machine that drives a server: .hq-remote holds that server's ssh host,
# and every command runs there, so agents never start on this machine.
# HQ_LOCAL=1 runs one command here anyway.
# A team moved here with `hq move` runs here; `team all`, `team stop all`
# and the listing cover both machines.
REMOTE="$HOME/code/business/hq/.hq-remote"
if [ -s "$REMOTE" ] && [ -z "${HQ_LOCAL:-}" ] && [ "${1:-}" != move ] && [ "${1:-}" != send ]; then
  here_groups() {
    for f in "$HOME/code/business/hq/.team-state"/home-*; do
      [ -s "$f" ] && [ "$(cat "$f")" = "$(hostname -s)" ] && basename "$f" | sed 's/^home-//'
    done
  }
  g=
  case "${1:-}" in
    mentor|plumber|designer) g=$1 ;;
    team) case "${2:-}" in stop) g=${3:-} ;; *) g=${2:-} ;; esac ;;
  esac
  local_run=
  if [ -n "$g" ] && [ "$g" != all ]; then
    here_groups | grep -qxF "$g" && local_run=1
  elif [ "${1:-}" = team ]; then
    for h in $(here_groups); do
      case "${2:-}" in
        all) HQ_TEAM_NO_ATTACH=1 "$BIN/team" "$h" ;;
        stop) "$BIN/team" stop "$h" ;;
        *) echo "living on this machine: $h" >&2 ;;
      esac
    done
  fi
  if [ -z "$local_run" ]; then
    cmd="\$HOME/code/business/hq/hq $(printf '%q ' "$@")"
    exec ssh -t "$(cat "$REMOTE")" "bash -ic $(printf '%q' "$cmd")"
  fi
fi

case "${1:-help}" in
  help|-h|--help)
    cat <<'EOF'
hq — founder command center

  hq mentor                   your advisor — above the teams, launched alone
  hq plumber                  the tooling session — scripts, charters,
                              skills, propagation into ventures; a bare
                              `claude` here is the same role, unnamed
  hq designer                 portfolio designer — serves every venture,
                              launched alone
  hq team <venture>           launch/resume that venture's working team
  hq team all                 every venture's team at once (explicit on purpose)
  hq team                     list ventures and which teams are running
  hq team stop <venture|all>  end a team's agents (they resume next launch)
  hq move <team> here|server  give a team (venture, mentor, plumber,
                              designer) a new home: stop it, carry its
                              work and conversations across, start it there
  hq send [file...]           laptop → agents: the clipboard (a screenshot
                              or Finder-copied files) or the named files
                              go to the server; their path is on your
                              clipboard to paste into the agent
  hq new [name]               start a new venture: short interview, then
                              scaffolding tailored to the venture's shape
  hq new --bare <name> ["thesis"]
                              skip the interview; scaffold the default
                              analyst+builder shape mechanically
  hq onboard                  first run on a fresh clone: setup, then
                              your first mentor session
  hq setup                    the mechanical half of onboard alone
                              (idempotent; safe to re-run any time)
  hq tidy                     hygiene check of charters and memory;
                              prints only problems
  hq publish                  mirror the shareable files into the public
                              template repo (--check: leak test only)
  hq help                     this list

Run from a laptop that drives a server (.hq-remote names its ssh host),
every command runs on the server.

Roster of sessions:  ~/code/business/hq/team.conf
Full documentation:  ~/code/business/hq/README.md  (or ask the mentor)
EOF
    ;;
  mentor) exec "$BIN/team" mentor ;;
  plumber) exec "$BIN/team" plumber ;;
  designer) exec "$BIN/team" designer ;;
  team) shift; exec "$BIN/team" "$@" ;;
  move) shift; exec "$BIN/move" "$@" ;;
  new|newventure)
    shift
    case "${1:-}" in
      --bare) shift; exec "$BIN/newventure" "$@" ;;
    esac
    cd "$HOME/code/business/hq" && exec claude "/new-venture $*"
    ;;
  setup) exec "$BIN/setup" ;;
  onboard)
    "$BIN/setup" || exit 1
    exec "$BIN/team" mentor
    ;;
  publish) shift; exec "$BIN/publish" "$@" ;;
  tidy) exec "$BIN/tidy" ;;
  send) shift; exec "$BIN/send" "$@" ;;
  *) echo "hq: unknown command '$1' — run 'hq help'" >&2; exit 1 ;;
esac
