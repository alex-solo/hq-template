{
  "agent": "plumber",
  "permissions": {
    "additionalDirectories": [
      "~/code/business/ventures"
    ],
    "allow": [
      "Read(~/code/business/ventures/**)",
      "Grep",
      "Glob",
      "Bash(git -C ~/code/business/ventures/* log*)",
      "Bash(git -C ~/code/business/ventures/* status*)",
      "Bash(git -C ~/code/business/ventures/* diff*)"
    ],
    "deny": [
      "Edit(~/code/business/ventures/*/src/**)",
      "Edit(~/code/business/ventures/*/apps/**)",
      "Edit(~/code/business/ventures/*/packages/**)",
      "Edit(~/code/business/ventures/*/docs/**)",
      "Edit(~/code/business/ventures/*/design/**)",
      "Edit(~/code/business/ventures/*/.claude/agent-memory/**)",
      "Edit(~/code/business/ventures/*/.env*)"
    ]
  },
  "autoMemoryEnabled": false
}
